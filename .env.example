# Clarity Mental Health & Wellness Platform
# Configuration & API Keys

# ==========================================
# 🤖 NuGen AI Chat Bot API Configuration
# ==========================================
# Obtain your API key from NuGen AI platform and paste it here:
NUGEN_API_KEY=your_nugen_api_key_here

# (Optional) NuGen Base API Endpoint URL (defaults to standard endpoint):
NUGEN_API_URL=https://api.nugen.ai/v1/chat/completions

# (Optional) NuGen Model Name:
NUGEN_MODEL=nugen-chat-default

# ==========================================
# 🌐 Fallback AI Providers (Optional)
# ==========================================
# Google Gemini API Key (Optional fallback):
GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenAI API Key (Optional fallback):
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# 🗄️ Database & Environment
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/clarity_db
NODE_ENV=development
